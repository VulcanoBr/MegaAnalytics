<div class="mx-auto w-full max-w-xl p-6">
  <%= render "shared/nav" %>
  <%= render "shared/flash" %>

  <h1 class="mb-2 text-2xl font-bold">Nova importação</h1>
  <p class="mb-6 text-gray-600">
    Envie a planilha oficial de resultados da Mega-Sena (.xlsx) disponibilizada pela Caixa.
    Concursos já importados e idênticos são ignorados; divergências rejeitam o arquivo inteiro.
  </p>

  <%= form_with url: import_batches_path, multipart: true, class: "space-y-4" do |form| %>
    <%= form.file_field :file, accept: ".xlsx",
          class: "block w-full rounded border p-2 text-sm" %>
    <div class="flex items-center gap-3">
      <%= form.submit "Importar", class: "rounded bg-emerald-600 px-4 py-2 text-white hover:bg-emerald-700" %>
      <%= link_to "Voltar", import_batches_path, class: "text-gray-600 underline" %>
    </div>
  <% end %>
</div>
